# =============================================
# Configurações do Servidor
# =============================================
# PORT é sobrescrito automaticamente pelo Render em produção.
# Deixe 3000 para desenvolvimento local.
PORT=3000

# Ambiente: development | production | test
NODE_ENV=development

# =============================================
# JWT (autenticação)
# =============================================
# PRODUÇÃO: gere uma secret forte e configure no dashboard do Render:
#   npx rand -M node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Depois adicione no Render > Settings > Environment > Add Secret
#   Key: JWT_SECRET  Value: <sua-secret-aqui>
JWT_SECRET=gacha-game-dev-secret-change-in-production

# Expiração do token JWT
JWT_EXPIRES_IN=7d

# =============================================
# Banco de Dados (SQLite local)
# =============================================
# Em desenvolvimento: data/gacha-game.db (autogerado)
# Em produção (Render): usa disco local (/opt/render/project/src/data/)
# DB_PATH=
